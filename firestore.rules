rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if resource belongs to authenticated user
    function belongsToUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate task data structure
    function isValidTaskData(data) {
      return data.keys().hasAny(['title', 'completed', 'userId', 'projectId', 'createdAt']) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 500 &&
             data.completed is bool &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }
    
    // Helper function to validate project data structure
    function isValidProjectData(data) {
      return data.keys().hasAny(['name', 'userId', 'createdAt']) &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 200 &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }
    
    // Helper function to validate label data structure
    function isValidLabelData(data) {
      return data.keys().hasAny(['name', 'color', 'userId', 'createdAt']) &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.color is string &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }
    
    // Helper function to validate estimation history data
    function isValidEstimationData(data) {
      return data.keys().hasAny(['userId', 'taskId', 'taskTitle']) &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.taskId is string &&
             data.taskTitle is string;
    }
    
    // Tasks collection - user can only access their own tasks
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
        isValidTaskData(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Projects collection - user can only access their own projects
    match /projects/{projectId} {
      allow read, write: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
        isValidProjectData(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Labels collection - user can only access their own labels
    match /labels/{labelId} {
      allow read, write: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
        isValidLabelData(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
    }
    
    // Estimation history collection - user can only access their own records
    match /estimation_history/{recordId} {
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() && 
        isValidEstimationData(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      
      // Estimation records are immutable once created for data integrity
      allow update: if false;
      allow delete: if false;
    }
    
    // Users collection - for potential user profile data
    // Each user can only access their own profile
    match /users/{userId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == userId;
      
      allow create: if isAuthenticated() && 
        request.auth.uid == userId;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
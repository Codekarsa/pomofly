# Firebase Configuration
# Required for authentication and data storage
# Get these values from your Firebase project console
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Claude AI Configuration
# Required for AI task breakdown feature
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-haiku-20240307

# Error Tracking & Performance Monitoring (Optional)
# Uncomment and configure to send monitoring data to external services

# Sentry for error tracking
# NEXT_PUBLIC_ERROR_TRACKING_ENDPOINT=https://your-sentry-dsn.ingest.sentry.io/api/your-project-id/store/

# DataDog or similar for performance metrics
# NEXT_PUBLIC_METRICS_ENDPOINT=https://api.datadoghq.com/api/v1/series

# Custom monitoring endpoints
# NEXT_PUBLIC_ERROR_TRACKING_ENDPOINT=https://your-api.com/errors
# NEXT_PUBLIC_METRICS_ENDPOINT=https://your-api.com/metrics

# Monitoring Configuration
NEXT_PUBLIC_MONITORING_ENABLED=true
NEXT_PUBLIC_MONITORING_SAMPLE_RATE=1.0
NEXT_PUBLIC_MONITORING_DEBUG=false

# Data Retention & Compliance API Security
# Required for automated data cleanup and GDPR compliance endpoints
# Generate secure random tokens for production use
CLEANUP_API_TOKEN=your-secure-cleanup-token-here
ADMIN_API_TOKEN=your-secure-admin-token-here

# Note: These tokens should be:
# - At least 32 characters long
# - Randomly generated (use crypto.randomBytes(32).toString('hex'))
# - Stored securely and rotated regularly
# - Different between environments (dev/staging/prod)
